{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stdm",
  "compatibility_date": "2024-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "stdm.berl1n.xyz",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
